# ===== Telegram (Telethon) =====
# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bot token from @BotFather (create a bot with /newbot)
TELEGRAM_BOT_TOKEN=
# The channel/group ID the bot watches (supergroups start with -100)
TELEGRAM_CHANNEL_ID=

# ===== Google / YouTube OAuth2 =====
# From https://console.cloud.google.com -> Credentials -> OAuth client ID (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled automatically after the first authorize step
GOOGLE_REFRESH_TOKEN=

# ===== Service =====
# Port the FastAPI service listens on
SERVICE_PORT=8000
