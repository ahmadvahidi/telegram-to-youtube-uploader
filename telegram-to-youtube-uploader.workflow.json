{
  "name": "telegram-to-youtube",
  "description": "Automatically upload videos from a Telegram channel/group to YouTube with captions, titles and tags.",
  "nodes": [
    {
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {
          "chatIds": "YOUR_CHAT_ID"
        }
      }
    },
    {
      "name": "Extract Video Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const msg = $json.message || {};\nconst messageId = msg.message_id;\nconst caption = msg.caption || msg.text || '';\nconst isVideo = !!(msg.video || msg.document || msg.video_note);\nconst lines = caption.split('\\n').map(l => l.trim()).filter(l => l);\nconst title = lines[0] || 'Untitled';\nconst tags = [...new Set((caption.match(/#([\\p{L}_][\\p{L}\\p{N}_]*)/gu) || []).map(t => t.slice(1)))];\nconst descLines = lines.slice(1).filter(l => !l.startsWith('#'));\nconst description = descLines.join('\\n');\nreturn [{ json: { messageId, caption, isVideo, title, description, tags } }];"
      }
    },
    {
      "name": "Is Video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.isVideo }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_SERVICE_HOST:8001/upload",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $json.messageId, title: $json.title, description: $json.description, tags: $json.tags }) }}"
      }
    },
    {
      "name": "Notify Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_CHAT_ID",
        "text": "=Video uploaded: {{ $json.url }}",
        "additionalFields": {}
      }
    },
    {
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "content": "Detects new videos in a Telegram channel/group and sends them to the Python service for download + YouTube upload."
      }
    }
  ]
}
